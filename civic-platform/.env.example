# ══════════════════════════════════════════════════════════════════════════════
# Smart Civic Intelligence Platform — Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` at the project root for docker-compose variable
# substitution (ports, resource sizing, image tags). Backend application
# secrets live separately in backend/.env — see backend/.env.example.

# ── Compose port mappings (host:container) ────────────────────────────────────
API_PORT=8000
DASHBOARD_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Dashboard build-time config ────────────────────────────────────────────────
# Set to the public-facing API path. Behind the edge proxy this stays relative;
# for a split-domain deployment, use the full backend URL instead.
DASHBOARD_API_URL=/api/v1

# ── Database credentials ──────────────────────────────────────────────────────
POSTGRES_USER=civic
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=civic_platform

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_in_production
REDIS_MAXMEMORY=512mb

# ── Celery ────────────────────────────────────────────────────────────────────
API_WORKERS=4
WORKER_CONCURRENCY=4

# ── Flower (Celery monitoring dashboard) ───────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=change_this_in_production

# ── pgAdmin (dev profile only) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@civic.local
PGADMIN_PASSWORD=admin

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CivicPlatformReadOwnSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:civic-platform/production-*",
        "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:civic-platform/staging-*"
      ]
    }
  ]
}

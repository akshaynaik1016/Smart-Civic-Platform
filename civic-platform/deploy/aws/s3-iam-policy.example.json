{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CivicPlatformS3ObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::smart-civic-media/*"
    },
    {
      "Sid": "CivicPlatformS3BucketListAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::smart-civic-media"
    }
  ]
}

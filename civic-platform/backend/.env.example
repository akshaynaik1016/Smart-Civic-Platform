# ══════════════════════════════════════════════════════════════════════════════
# Smart Civic Intelligence Platform — Backend Application Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy to backend/.env. These map 1:1 to app/core/config.py::Settings fields.
# NEVER commit a real .env with production secrets to version control.
#
# ── Two ways to supply these values in production ────────────────────────────
# 1. (shown below) Plain .env file on the host — simplest, fine for a single
#    small VM, but the secret values sit in plaintext on disk.
# 2. AWS Secrets Manager — set SECRETS_PROVIDER=aws_secrets_manager and
#    AWS_SECRETS_MANAGER_SECRET_NAME, and leave the actual secret fields
#    below BLANK. app/core/secrets_provider.py fetches real values at
#    container startup before Settings() is constructed. Push values with
#    scripts/push_secrets_to_aws.py. See backend/app/core/secrets_provider.py
#    for the full explanation and IAM permissions required.
#
# SECRETS_PROVIDER=aws_secrets_manager
# AWS_SECRETS_MANAGER_SECRET_NAME=civic-platform/production
#
# Generate strong values for the secret fields below with:
#   python scripts/generate_secrets.py

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="Smart Civic Intelligence Platform"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=replace_with_a_long_random_string
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# ── Database ──────────────────────────────────────────────────────────────────
# Must match the compose service hostname `postgres`, not `localhost`, when
# running inside Docker.
DATABASE_URL=postgresql+asyncpg://civic:civic@postgres:5432/civic_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────────
# Include the password configured in docker-compose's redis service command.
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_a_separate_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AWS S3 (media storage) ──────────────────────────────────────────────────
# Leave blank to use local-filesystem fallback storage (dev only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=smart-civic-media
AWS_S3_CDN_URL=
AWS_S3_PRESIGNED_EXPIRY=3600

# ── CloudFront (optional — CDN-aware signed URLs) ───────────────────────────
# Leave all three blank to use direct S3 presigned URLs (no CDN required).
# See backend/app/storage/cloudfront_signer.py for the full explanation.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# ── Firebase (push notifications) ───────────────────────────────────────────
# Paste the full service-account JSON as a single-line string, or leave blank
# to disable push notifications (in-app notifications still work).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# ── Sentry (error tracking) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── AI / YOLOv8 ──────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=models/yolov8n-civic.pt
YOLO_CONFIDENCE_THRESHOLD=0.75
DUPLICATE_RADIUS_METRES=500.0
DUPLICATE_IMAGE_SIMILARITY_THRESHOLD=0.85

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_COMPLAINT_POST=5/minute
RATE_LIMIT_AI_PROCESS=3/minute

# ── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── File upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:changeme@redis:6379/1
CELERY_RESULT_URL=redis://:changeme@redis:6379/2

# ── Email (SMTP — OTP & status notifications) ────────────────────────────────
# Leave SMTP_USER/SMTP_PASSWORD blank to disable email sending (logs instead).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@smartcivic.gov.in

# ── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Flower basic auth (referenced by root docker-compose.yml) ────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=changeme
